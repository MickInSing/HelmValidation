  {
   "type": "timeseries",
   "title": "Scans per day by status",
   "id": 6,
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "helmviz-pg"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "helmviz-pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "time_series",
     "rawSql": "SELECT $__timeGroupAlias(scanned_at, '1d'), status AS metric, count(*) AS value FROM scans WHERE $__timeFilter(scanned_at) GROUP BY 1, 2 ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60,
      "stacking": {
       "mode": "normal"
      },
      "lineWidth": 2,
      "pointSize": 5,
      "showPoints": "auto"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Score trend per repository",
   "id": 7,
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "helmviz-pg"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "helmviz-pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "time_series",
     "rawSql": "SELECT $__timeGroupAlias(scanned_at, '1d'), repo || coalesce(' / ' || chart_path, '') AS metric, round(avg(score)) AS value FROM scans WHERE $__timeFilter(scanned_at) AND score IS NOT NULL GROUP BY 1, 2 ORDER BY 1"
