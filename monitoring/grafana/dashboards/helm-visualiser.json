  {
   "type": "barchart",
   "title": "Top failing rules (scans affected)",
   "id": 9,
   "description": "What to train people on. Accepted exceptions are excluded.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "helmviz-pg"
   },
   "gridPos": {
    "h": 10,
    "w": 12,
    "x": 0,
    "y": 14
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "helmviz-pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT r.rule_id AS rule, count(DISTINCT r.scan_id) AS scans FROM scan_rules r JOIN scans s ON s.id = r.scan_id WHERE $__timeFilter(s.scanned_at) AND NOT r.accepted GROUP BY 1 ORDER BY 2 DESC LIMIT 15"
    }
   ],
   "options": {
    "orientation": "horizontal",
    "showValue": "auto",
    "xTickLabelRotation": 0,
    "legend": {
     "showLegend": false,
     "displayMode": "list",
     "placement": "bottom"
    },
    "barWidth": 0.7
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "fixed",
      "fixedColor": "orange"
     }
    },
    "overrides": []
   }
  },
  {
   "type": "table",
   "title": "Findings by framework and severity",
   "id": 10,
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "helmviz-pg"
   },
   "gridPos": {
    "h": 10,
    "w": 12,
    "x": 12,
    "y": 14
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "helmviz-pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT r.category AS framework, r.severity, sum(r.count) AS findings, count(DISTINCT r.scan_id) AS scans FROM scan_rules r JOIN scans s ON s.id = r.scan_id WHERE $__timeFilter(s.scanned_at) AND NOT r.accepted GROUP BY 1, 2 ORDER BY 1, array_position(ARRAY['critical','high','medium','low','info'], r.severity)"
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "filterable": true
     }
    },
    "overrides": []
   }
  },
