  {
   "type": "table",
   "title": "Platform dependencies (charts rely on)",
   "id": 15,
   "description": "Operators, CRDs, ArgoCD values, lookup/capabilities and pre-existing objects found across charts.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "helmviz-pg"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 33
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "helmviz-pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT d.label AS dependency, d.category, count(DISTINCT s.repo) AS repos, count(DISTINCT s.id) AS scans FROM scan_dependencies d JOIN scans s ON s.id = d.scan_id WHERE $__timeFilter(s.scanned_at) GROUP BY 1, 2 ORDER BY 3 DESC, 4 DESC"
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
