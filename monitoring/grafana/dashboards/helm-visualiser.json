  {
   "type": "table",
   "title": "Never passing (best score < 70)",
   "id": 12,
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "helmviz-pg"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 25
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "helmviz-pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT repo, coalesce(chart_path, '') AS chart, max(score) AS best_score, count(*) AS scans, max(scanned_at) AS last_scan FROM scans WHERE source_type = 'git' GROUP BY 1, 2 HAVING coalesce(max(score), 0) < 70 ORDER BY 3 NULLS FIRST"
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "filterable": true
     }
    },
    "overrides": []
   }
  },
  {
   "type": "table",
   "title": "Stale (not scanned in 30 days)",
   "id": 13,
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "helmviz-pg"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 25
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "helmviz-pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT repo, coalesce(chart_path, '') AS chart, max(scanned_at) AS last_scan, date_part('day', now() - max(scanned_at))::int AS days_ago FROM scans WHERE source_type = 'git' GROUP BY 1, 2 HAVING max(scanned_at) < now() - interval '30 days' ORDER BY 3"
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "filterable": true
     }
    },
    "overrides": []
   }
  },
  {
   "type": "piechart",
   "title": "Render failures by cause",
   "id": 14,
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "helmviz-pg"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 33
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "helmviz-pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT coalesce(error_class, 'unknown') AS cause, count(*) AS scans FROM scans WHERE $__timeFilter(scanned_at) AND status <> 'ok' GROUP BY 1 ORDER BY 2 DESC"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
